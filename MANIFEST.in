include AGENTS.md
include CHANGELOG.md
include CONTRIBUTING.md
include LICENSE
include README.md
include SECURITY.md
include .env.example
recursive-include config *.json
recursive-include docs *.md
recursive-include examples *.csv *.json *.txt
recursive-include scripts *.py
recursive-include tests *.csv *.json *.py
global-exclude __pycache__ *.py[cod]
prune .market_validator
prune .release-check
